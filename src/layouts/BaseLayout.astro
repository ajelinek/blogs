---
import Navigation from '../components/static/Navigation.astro'
import '../styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class='site-wrapper'>
      <Navigation />
      <slot />
      <footer>
        <div class='container'>
          <p>&copy; {new Date().getFullYear()} Blog & Presentations</p>
        </div>
      </footer>
    </div>
  </body>
</html>

