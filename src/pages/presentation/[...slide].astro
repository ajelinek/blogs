---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPresentationsWithSlides } from '../../parsers/presentation/presentationCollection'
import type { PresentationWithSlides } from '../../parsers/presentation/presentationCollection'
import type { SlideNode } from '../../parsers/presentation/presentationParser'

// Define the expected shape for items in the paths array
interface StaticPath {
  params: { slide: string }
  props: {
    presentationData: PresentationWithSlides
    slideNode: SlideNode
  }
}

export async function getStaticPaths(): Promise<StaticPath[]> {
  const presentationsWithSlides = await getPresentationsWithSlides()
  const paths: StaticPath[] = []

  for (const presentationData of presentationsWithSlides) {
    if (presentationData.slideMap && presentationData.slideMap.size > 0) {
      // Add path for the presentation root, mapping to S1
      const firstSlideNode = presentationData.slideMap.get('S1')
      if (firstSlideNode) {
        paths.push({
          params: { slide: presentationData.slug }, // e.g., 'sample-presentation'
          props: {
            presentationData,
            slideNode: firstSlideNode, // Explicitly use S1 for root
          },
        })
      }

      // Add paths for all individual slides, including S1 again with its full slug/S1 path
      // Astro should handle one of these taking precedence or deduplicating if props are identical.
      for (const slideNode of Array.from(presentationData.slideMap.values())) {
        paths.push({
          params: { slide: `${presentationData.slug}/${slideNode.id}` },
          props: { presentationData, slideNode },
        })
      }
    }
  }
  return paths
}

interface Props {
  presentationData: PresentationWithSlides
  slideNode: SlideNode
}

const { presentationData, slideNode } = Astro.props as Props
const { title } = presentationData
const { id, content, prevId, nextId, childId, parentId } = slideNode

// Handle navigation links
const presentationSlug = presentationData.slug
const basePath = `/jelly-time/presentation/${presentationSlug}`

// Previous link
let prevLink: string | null = null
if (prevId) {
  prevLink = prevId === 'S1' ? basePath : `${basePath}/${prevId}`
} else if (parentId) {
  prevLink =
    parentId === 'S1' && presentationData.slideMap.get(parentId)?.parentId === null
      ? basePath
      : `${basePath}/${parentId}`
}

// Next link
let nextLink: string | null = null
if (nextId) {
  nextLink = `${basePath}/${nextId}`
}

// Child links (first child)
let childLink: string | null = null
if (childId) {
  childLink = `${basePath}/${childId}`
}
---

<BaseLayout title={`${title} | Slide ${id}`}>
  <article aria-labelledby='presentation-title' class='presentation'>
    <header>
      <h1 id='presentation-title'>{title}</h1>
      <div class='slide-info'>
        <span class='slide-id'>Slide {id}</span>
      </div>
    </header>

    <div class={`slide`} data-slide-id={id}>
      <div class='slide-content'>
        {content ? <div set:html={content} /> : <p class='empty-slide'>(This slide has no content)</p>}
      </div>
    </div>

    <nav aria-label='Slide navigation' class='slide-navigation'>
      <div class='nav-links'>
        {
          prevLink && (
            <a href={prevLink} class='nav-link prev-link'>
              &laquo; Previous
            </a>
          )
        }

        {
          childLink && (
            <a href={childLink} class='nav-link child-link'>
              Child Slides &darr;
            </a>
          )
        }

        {
          nextLink && (
            <a href={nextLink} class='nav-link next-link'>
              Next &raquo;
            </a>
          )
        }
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .presentation {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  header {
    margin-bottom: 2rem;
  }

  .slide-info {
    color: #666;
    font-size: 0.9rem;
  }

  .slide {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 2rem;
    margin-bottom: 2rem;
    background-color: #f9f9f9;
  }

  .slide-content {
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .empty-slide {
    color: #999;
    font-style: italic;
  }

  .slide-navigation {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #eee;
  }

  .nav-links {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: #f0f0f0;
    color: #333;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s;
  }

  .nav-link:hover {
    background-color: #e0e0e0;
  }

  .child-link {
    background-color: #e8f4fd;
  }

  .child-link:hover {
    background-color: #d1e9f7;
  }
</style>
