---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import BlogCard from '../components/static/BlogCard.astro'

// Get all blog posts
const allPosts = await getCollection('blog')

// Sort by date (newest first)
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

// Get unique tags
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))]

// Get current page from URL params
const page = 1
const postsPerPage = 6
const totalPages = Math.ceil(sortedPosts.length / postsPerPage)
const currentPosts = sortedPosts.slice(0, postsPerPage)

// Get current tag filter from URL params
const tag = Astro.url.searchParams.get('tag')
const filteredPosts = tag ? sortedPosts.filter(post => post.data.tags.includes(tag)) : currentPosts
---

<BaseLayout title={tag ? `${tag} Posts | Blog` : 'Blog | Articles and Tutorials'}>
  <main>
    <section aria-label='Blog Header' class='page-header'>
      <div class='container'>
        <h1>{tag ? `Posts tagged with "${tag}"` : 'Blog Posts'}</h1>
        <p>Technical articles and tutorials</p>
      </div>
    </section>

    <section aria-label='Tag Filter' class='tag-filter'>
      <div class='container'>
        <ul class='tags' role='list'>
          <li role='listitem'><a href='/jelly-time/blog' class={!tag ? 'active' : ''}>All</a></li>
          {
            allTags.map(tagName => (
              <li role='listitem'>
                <a href={`/jelly-time/blog?tag=${tagName}`} class={tag === tagName ? 'active' : ''}>
                  {tagName}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section aria-label='Blog Posts' class='posts'>
      <div class='container'>
        {
          filteredPosts.length > 0 ? (
            <div class='post-grid'>
              {filteredPosts.map(post => (
                <BlogCard post={post} />
              ))}
            </div>
          ) : (
            <div class='no-posts'>
              <p>No posts found{tag ? ` with tag "${tag}"` : ''}.</p>
            </div>
          )
        }
      </div>
    </section>

    {
      !tag && totalPages > 1 && (
        <section aria-label='Pagination' class='pagination'>
          <div class='container'>
            <div class='pagination-controls'>
              <a href={`/jelly-time/blog?page=${Math.max(1, page - 1)}`} class={page <= 1 ? 'disabled' : ''}>
                Previous
              </a>
              <span>
                Page {page} of {totalPages}
              </span>
              <a
                href={`/jelly-time/blog?page=${Math.min(totalPages, page + 1)}`}
                class={page >= totalPages ? 'disabled' : ''}>
                Next
              </a>
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .tag-filter {
    margin-bottom: 2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tags a {
    background-color: #f0f0f0;
    color: #666;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tags a:hover,
  .tags a.active {
    background-color: #0077cc;
    color: white;
  }

  .pagination {
    margin-top: 3rem;
  }

  .pagination-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .pagination-controls a {
    padding: 0.5rem 1rem;
    background-color: #f0f0f0;
    color: #333;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .pagination-controls a:hover:not(.disabled) {
    background-color: #0077cc;
    color: white;
  }

  .pagination-controls a.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .no-posts {
    text-align: center;
    padding: 3rem 0;
  }
</style>
