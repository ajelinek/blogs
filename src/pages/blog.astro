---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { BlogListing } from '../components/dynamic'
import type { BlogPost } from '../components/dynamic/BlogCard'

// Get all blog posts
const allPosts = await getCollection('blog')

// Sort by date (newest first) and add slug property to match BlogPost type
const sortedPosts = allPosts
  .map(post => ({ ...post, slug: post.id }))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) as BlogPost[]
---

<BaseLayout title='Blog | Articles and Tutorials'>
  <main>
    <section aria-label='Blog Header' class='page-header'>
      <div class='container'>
        <h1>Blog Posts</h1>
        <p>Technical articles and tutorials</p>
      </div>
    </section>

    <div class='container'>
      <BlogListing posts={sortedPosts} postsPerPage={6} client:load />
    </div>
  </main>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
