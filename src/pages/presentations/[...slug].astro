---
import { getCollection, type CollectionEntry } from 'astro:content'
import fs from 'node:fs/promises'
import path from 'node:path'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { parseSlides, type SlideNode, type ParsedSlidesOutput } from '../../utilities/slideParser'
import SlideComponent from '../../components/dynamic/Presentation/Slide.astro'

export async function getStaticPaths() {
  const presentations = await getCollection('presentations')
  return presentations.map(presentation => ({
    params: { slug: presentation.slug },
    props: { presentationEntry: presentation },
  }))
}

interface Props {
  presentationEntry: CollectionEntry<'presentations'>
}

const { presentationEntry } = Astro.props as Props
const { data: presentationData, slug } = presentationEntry

let rawMdxContent = ''

const potentialPath1 = path.join(process.cwd(), 'src', 'content', 'presentations', `${slug}.mdx`)
const potentialPath2 = path.join(process.cwd(), 'src', 'content', 'presentations', slug, 'index.mdx')

try {
  rawMdxContent = await fs.readFile(potentialPath1, 'utf-8')
} catch (e) {
  try {
    rawMdxContent = await fs.readFile(potentialPath2, 'utf-8')
  } catch (e2) {
    console.error(`Error reading MDX file for presentation: ${slug}`, e2)
  }
}

const parsedOutput: ParsedSlidesOutput = rawMdxContent
  ? parseSlides(rawMdxContent)
  : { rootSlideId: null, slides: new Map() }
const slidesArray: SlideNode[] = Array.from(parsedOutput.slides.values()).sort((a, b) =>
  a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' })
)
---

<BaseLayout title={presentationData.title}>
  <article aria-labelledby='presentation-title'>
    <h1 id='presentation-title'>{presentationData.title}</h1>
    {presentationData.description && <p>{presentationData.description}</p>}

    <div class='presentation-slides-deck'>
      {
        slidesArray.length > 0 ? (
          slidesArray.map((slide, index) => (
            <SlideComponent slide={slide} slideNumber={(index + 1).toString()} baseAriaLabel='Slide' />
          ))
        ) : (
          <p>This presentation does not contain any slides or could not be loaded.</p>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .presentation-slides-deck {
    margin-top: 2rem;
  }
</style>
