---
import styles from './Navigation.module.css'

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Presentations', href: '/presentations' },
]
---

<nav class={styles.navigation} aria-label='Main navigation'>
  <div class='container'>
    <div class={styles.navContainer}>
      <a href='/' class={styles.logo}>
        Blog<span>&</span>Presentations
      </a>
      <ul class={styles.navList} role='list'>
        {
          navItems.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class={Astro.url.pathname === href ? styles.active : ''}
                aria-current={Astro.url.pathname === href ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

