---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../../store/utilities/dateUtils'
import styles from './blog-card.module.css'

type Props = {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, author, tags, image } = post.data
const url = `/jelly-time/blog/${post.slug}`
---

<article class={styles.blogCard}>
  <a href={url} class={styles.imageContainer}>
    {image && <img src={image} alt={title} />}
  </a>
  <div class={styles.content}>
    <div class={styles.meta}>
      <span class={styles.date}>{formatDate(pubDate)}</span>
      <span class={styles.author}>By {author}</span>
    </div>
    <h2><a href={url}>{title}</a></h2>
    <p class={styles.description}>{description}</p>
    <div class={styles.tags}>
      {
        tags.map((tag: string) => (
          <a href={`/jelly-time/blog/tag/${tag}`} class={styles.tag}>
            {tag}
          </a>
        ))
      }
    </div>
  </div>
</article>
