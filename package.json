{
  "name": "blogs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 4333 --host",
    "start": "astro dev --port 4333 --host",
    "build": "tsc --noEmit && astro build",
    "preview": "astro preview --port 4333 --host",
    "astro": "astro",
    "lint": "eslint --ext .js,.ts,.astro src",
    "format": "prettier --write .",
    "test": "NODE_ENV=test playwright test --project=chromium --retries=1 --reporter=list",
    "test:ui": "NODE_ENV=test playwright test --ui",
    "test:blog-framework": "NODE_ENV=test playwright test e2e/spec/blog-framework.spec.ts --project=chromium",
    "test:unit": "NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.6",
    "@astrojs/solid-js": "^4.0.1",
    "astro": "^5.7.12",
    "reading-time": "^1.5.0",
    "sharp": "^0.34.1",
    "solid-js": "^1.8.15",
    "solidjs-use": "^2.3.0",
    "zod": "4.0.0-beta.20250505T195954"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "vitest": "^3.1.3"
  },
  "packageManager": "pnpm@10.6.5"
}
